# ─── Database ────────────────────────────────────────────────────────────────
# Zero-config demo runs on SQLite (no setup needed):
DATABASE_URL="file:./dev.db"
#
# Production: point at Supabase Postgres and switch the provider in
# prisma/schema.prisma to "postgresql".
# DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[REF].supabase.co:5432/postgres"

# ─── Email (optional) ────────────────────────────────────────────────────────
# Without a key, confirmation emails are logged to the server console (demo mode).
# RESEND_API_KEY="re_xxxxxxxx"
# RESEND_FROM="Amelia & Mateo <hello@yourdomain.com>"

# ─── Admin ───────────────────────────────────────────────────────────────────
# Passcode for the /admin dashboard (demo gate). Defaults to "demo" if unset.
ADMIN_PASSCODE="demo"
